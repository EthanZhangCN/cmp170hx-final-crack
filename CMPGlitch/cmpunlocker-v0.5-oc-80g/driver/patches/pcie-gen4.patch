+     * Training to Gen4 still needs SYSTEM_MAX_SPEED (kernel_gsp.c Booter hunk). */
+    if (status == NV_OK && ((pGpu->idInfo.PCIDeviceID >> 16) == 0x20C2 ||
+                            (pGpu->idInfo.PCIDeviceID >> 16) == 0x2082))
+    {
+        NvU32 enableGen4 = 0;
+        (void)osReadRegistryDword(pGpu, "CmpGen4", &enableGen4);
+        if (enableGen4 == 1)
